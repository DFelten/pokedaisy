@@ -180,10 +180,25 @@ extern "C" void wasm_rt_free_memory(wasm_rt_memory_t *memory) {
     std::free(memory->private_data);
 }
 
+// The function table's size as the module made it (PokeDaisy): every entry past it was pushed by a binding at run time
+// (a host function handed to Ruby), so save states carry those entries (sandbox-serial-core.h) - the game's memory holds
+// their indices, and a new process pushes them in another order, or not yet.
+extern "C" uint32_t mkxp_wasm_rt_funcref_initial_size = 0;
+
 extern "C" void wasm_rt_allocate_funcref_table(wasm_rt_funcref_table_t *table, uint32_t elements, uint32_t max_elements) {
     table->private_data = new std::vector<wasm_rt_funcref_t>(elements);
     table->data = ((std::vector<wasm_rt_funcref_t> *)table->private_data)->data();
     table->size = elements;
+    mkxp_wasm_rt_funcref_initial_size = elements;
+}
+
+// Replaces the table's entries from [first] on with [count] [entries] (a save state's).
+extern "C" void mkxp_wasm_rt_set_funcrefs(wasm_rt_funcref_table_t *table, uint32_t first, const wasm_rt_funcref_t *entries, uint32_t count) {
+    auto &vec = *(std::vector<wasm_rt_funcref_t> *)table->private_data;
+    vec.resize(first);
+    vec.insert(vec.end(), entries, entries + count);
+    table->data = vec.data();
+    table->size = (uint32_t)vec.size();
 }
 

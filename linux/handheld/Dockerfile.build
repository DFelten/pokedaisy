# Builds the host on glibc 2.31 / SDL 2.0.14 (Debian 11, now in Debian's archive), so it loads on the old-ArkOS stand-in too.
FROM --platform=linux/arm64 debian:bullseye
RUN printf 'deb http://archive.debian.org/debian bullseye main\ndeb http://archive.debian.org/debian-security bullseye-security main\n' > /etc/apt/sources.list && apt-get update && apt-get install -y --no-install-recommends cmake gcc g++ make libsdl2-dev python3 binutils && rm -rf /var/lib/apt/lists/*

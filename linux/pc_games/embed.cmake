# Writes OUT, a C header with each Ruby preload script as a byte array (name, data, size), for hw_gl / main.c to install
# into the mkxp-z core's Scripts/Preload folder. cmake -DOUT=... -DDIR=<this folder> -P embed.cmake
set(body "// Generated by linux/pc_games/embed.cmake from linux/pc_games/*.rb. Do not edit.\n#pragma once\n#include <stddef.h>\n")
set(table "static const struct { const char *name; const unsigned char *data; size_t size; } pcPreloads[] = {\n")
file(GLOB FILES ${DIR}/*.rb)
list(SORT FILES)
set(i 0)
foreach(f ${FILES})
  get_filename_component(name ${f} NAME)
  file(READ ${f} hex HEX)
  string(LENGTH "${hex}" len)
  math(EXPR size "${len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "static const unsigned char pcPreload${i}[] = {${bytes}};\n")
  string(APPEND table "  {\"${name}\", pcPreload${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND table "};\n")
file(WRITE ${OUT} "${body}${table}")

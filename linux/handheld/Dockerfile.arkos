# Stand-in for the old ArkOS userland (Ubuntu 19.10 eoan, aarch64).
FROM --platform=linux/arm64 ubuntu:19.10
RUN sed -i 's|ports.ubuntu.com/ubuntu-ports|old-releases.ubuntu.com/ubuntu|g; s|http://[a-z.]*ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' /etc/apt/sources.list && apt-get update && apt-get install -y --no-install-recommends libsdl2-2.0-0 python3 bash && rm -rf /var/lib/apt/lists/*
